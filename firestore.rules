rules_version = '2';

service cloud.firestore {
  // Use the correct databaseId
  match /databases/{database}/documents {
    match /concepts/{conceptId} {
      // Allow users to read, create, and delete their own concepts
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      // Allow users to create concepts, ensuring they set their own userId
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      // Prevent updating for simplicity, or allow if userId matches
      allow update: if request.auth != null && request.auth.uid == resource.data.userId && request.auth.uid == request.resource.data.userId;
    }
  }
}
